# Este archivo solo documenta las variables de entorno del proyecto.
# El archivo .env real NO se sube al repositorio (está en .gitignore): cópielo con
# `Copy-Item .env.example .env` y sustituya los valores de ejemplo.
# Todas las contraseñas de ejemplo son literalmente `change-me`: NO son secretos y no deben usarse
# fuera de su máquina de desarrollo.
#
# CONTRASEÑAS: use solo los caracteres [A-Za-z0-9._~-]. Otros (@ : / ' % y espacios) rompen las URL
# de conexión o el SQL de creación de roles. Para generar una contraseña aleatoria:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# La misma contraseña de cada rol debe aparecer en su variable *_PASSWORD y en sus URL de conexión.

# --- Administrador del contenedor de PostgreSQL ---
# Usuario administrador del contenedor (solo lo usa el script de inicio; la aplicación no lo usa).
POSTGRES_USER=postgres
# Contraseña del administrador del contenedor (secreta).
POSTGRES_PASSWORD=change-me

# --- Contraseñas de los roles de la aplicación (se crean al iniciar el contenedor con volumen vacío) ---
# owner: dueño del esquema; migra y concede permisos (secreta).
OWNER_PASSWORD=change-me
# writer: lo usa la API para leer y escribir tareas (secreta).
WRITER_PASSWORD=change-me
# reader: solo lee la vista de conteos; lo usará el frontend (secreta).
READER_PASSWORD=change-me

# --- Bases de datos ---
# Nombre de la base de desarrollo: 1 a 63 caracteres [a-z0-9_].
DB_NAME=todo_app
# Nombre de la base de pruebas: mismas reglas y DEBE terminar en _test.
DB_NAME_TEST=todo_app_test
# Puerto publicado en 127.0.0.1 (5433 evita chocar con un PostgreSQL instalado en el equipo).
DB_LOCAL_PORT=5433

# --- Aplicación (el backend valida estas variables al cargar la configuración) ---
# URL de conexión de la API: usuario `writer` obligatorio, sin parámetros de consulta (secreta).
DATABASE_URL=postgresql://writer:change-me@127.0.0.1:5433/todo_app
# Tamaño máximo del pool de conexiones (entero 1-100; por defecto 10 si no se define).
DB_POOL_MAX=10
# Milisegundos que un cliente inactivo permanece abierto (entero 1000-600000; por defecto 30000).
DB_POOL_IDLE_TIMEOUT_MS=30000
# Milisegundos de espera para obtener una conexión (entero 100-60000; por defecto 5000).
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Puerto en el que escucha el servicio (entero 1-65535; por defecto 3000 si no se define).
PORT=3000
# Dirección IP literal en la que escucha el servicio (por defecto 127.0.0.1: solo este equipo). 0.0.0.0 y :: escuchan
# en TODAS las interfaces: úselas solo dentro de la red interna de un contenedor, nunca en una máquina expuesta.
HOST=127.0.0.1
# Plazo máximo, en milisegundos, para el cierre ordenado (entero 1000-120000; por defecto 10000).
SHUTDOWN_TIMEOUT_MS=10000
# Clave de la API (obligatoria, secreta): de 43 a 128 caracteres de A-Z a-z 0-9 _ - con al menos 10 distintos. NO se
# verifica la entropía: genérela siempre con este comando (32 bytes aleatorios, 43 caracteres):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# El valor de abajo es solo un ejemplo (no es un secreto) y el servicio lo rechaza al arrancar: sustitúyalo.
API_KEY=change-me-use-randomBytes-32

# --- Migración y frontend ---
# URL del usuario `owner`: solo para migrar y aplicar permisos (secreta).
OWNER_DATABASE_URL=postgresql://owner:change-me@127.0.0.1:5433/todo_app
# URL del usuario `reader`: frontend y tests de permisos (secreta).
READER_DATABASE_URL=postgresql://reader:change-me@127.0.0.1:5433/todo_app

# --- Solo tests (siempre sobre la base de pruebas, que termina en _test) ---
# URL del usuario `writer` sobre la base de pruebas (secreta).
TEST_DATABASE_URL=postgresql://writer:change-me@127.0.0.1:5433/todo_app_test
# URL del usuario `owner` sobre la base de pruebas (secreta).
TEST_OWNER_DATABASE_URL=postgresql://owner:change-me@127.0.0.1:5433/todo_app_test
# URL del usuario `reader` sobre la base de pruebas (secreta).
TEST_READER_DATABASE_URL=postgresql://reader:change-me@127.0.0.1:5433/todo_app_test

# --- Frontend (Next.js) ---
# (se completa en la spec correspondiente)
