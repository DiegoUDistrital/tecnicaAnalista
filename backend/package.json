{
  "name": "todo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de la To-Do App: capa de datos (PostgreSQL, Prisma y pg).",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "start": "npm run build && node --env-file=../.env dist/index.js",
    "db:deploy": "npm run build && node --env-file=../.env dist/db/migrate-cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
